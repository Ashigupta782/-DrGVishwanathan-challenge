class Solution {
public:
    vector<int> findAnagrams(string s, string p) {

        vector<int> ans;

        int n = s.size();
        int m = p.size();

        if (m > n)
            return ans;

        vector<int> freq1(26, 0);
        vector<int> freq2(26, 0);

        // Store frequencies of p and first window of s
        for (int i = 0; i < m; i++) {
            freq1[p[i] - 'a']++;
            freq2[s[i] - 'a']++;
        }

        // Check first window
        if (freq1 == freq2) {
            ans.push_back(0);
        }

        // Slide the window
        for (int i = m; i < n; i++) {

            // Add new character
            freq2[s[i] - 'a']++;

            // Remove character leaving the window
            freq2[s[i - m] - 'a']--;

            // Compare frequencies
            if (freq1 == freq2) {
                ans.push_back(i - m + 1);
            }
        }

        return ans;
    }
};
