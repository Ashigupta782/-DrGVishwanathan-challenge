class Solution {
public:
    int maximumSum(vector<int>& arr) {

        int n = arr.size();

        int noDelete = arr[0];
        int oneDelete = 0;

        int ans = arr[0];

        for (int i = 1; i < n; i++) {

            int currNoDelete = max(arr[i], noDelete + arr[i]);

            int currOneDelete = max(noDelete, oneDelete + arr[i]);

            noDelete = currNoDelete;
            oneDelete = currOneDelete;

            ans = max(ans, max(noDelete, oneDelete));
        }

        return ans;
    }
};
